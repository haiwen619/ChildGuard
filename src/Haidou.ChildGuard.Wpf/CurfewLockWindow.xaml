<Window x:Class="Haidou.ChildGuard.App.CurfewLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Curfew.Title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        WindowState="Maximized"
        Background="#F5070A0F"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#111622" BorderBrush="#1C273B" BorderThickness="1.5"
                CornerRadius="20" Padding="40,36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="#000000" Opacity="0.9" ShadowDepth="12"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <Border Background="#1C273B" CornerRadius="35" Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🌙" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{DynamicResource Curfew.Title}" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtCurfewPrompt" Text="当前处于健康就寝时段 (22:00 ~ 07:00)" FontSize="13.5" FontWeight="SemiBold" Foreground="#58A6FF" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <TextBlock Text="{DynamicResource Curfew.Subtitle}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="#8B949E" LineHeight="20" Margin="0,0,0,28"/>

                <!-- 密码输入区域 (供家长临时放行) -->
                <StackPanel x:Name="PanelAuth" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="请输入家长管理密码临时解锁 30 分钟:" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputPassword" Height="36" Background="#0A0E17" Foreground="#FFFFFF" BorderBrush="#30363D" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtError" Text="" FontSize="11.5" Foreground="#FF7B72" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="{DynamicResource Common.Cancel}" Appearance="Secondary" Height="34" Click="BtnCancelAuth_Click"/>
                        <ui:Button Grid.Column="2" Content="{DynamicResource Common.Confirm}" Appearance="Primary" Height="34" Click="BtnConfirmAuth_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PanelDefaultBtns" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="{DynamicResource Curfew.ParentUnlock}" Appearance="Secondary" Height="38" Padding="20,0" Margin="0,0,12,0" Click="BtnRequestParent_Click"/>
                    <ui:Button Content="🔌 正常关机睡觉" Appearance="Primary" Height="38" Padding="20,0" Click="BtnShutdown_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
