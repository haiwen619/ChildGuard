<Window x:Class="Haidou.ChildGuard.App.EyeCareBreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="科学用眼 · 远眺休息"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        WindowState="Maximized"
        Background="#E6090D11"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Border Width="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#131B16" BorderBrush="#223E2E" BorderThickness="1.5"
                CornerRadius="20" Padding="36,32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="#000000" Opacity="0.9" ShadowDepth="12"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- 顶部徽章 -->
                <Border Background="#1C3827" CornerRadius="12" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌿" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="科学用眼健康闹钟 · 保护视力与颈椎" FontSize="13" FontWeight="SemiBold" Foreground="#3FB950" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 大标题 -->
                <TextBlock Text="护眼时间到啦，让双眼小憩一会儿" FontSize="23" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="已经连续专注用眼较长时间，请离开屏幕，望向 5 米外的窗外或绿植放松睫状肌" FontSize="12.5" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- 倒计时展示 -->
                <Border Background="#0C140F" BorderBrush="#1C3827" BorderThickness="1" CornerRadius="16" Width="260" Padding="20,14" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtCountdown" Text="05:00" FontSize="56" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Center"/>
                        <TextBlock Text="建议远眺放松倒计时" FontSize="11.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4 步护眼操指引卡片 -->
                <Grid Margin="0,0,0,28" Width="580">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#18231C" CornerRadius="10" Padding="10,12">
                        <StackPanel>
                            <TextBlock Text="👀" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="1. 眨眼放松" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                            <TextBlock Text="缓慢闭眼3次" FontSize="10.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#18231C" CornerRadius="10" Padding="10,12">
                        <StackPanel>
                            <TextBlock Text="🌲" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="2. 眺望窗外" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                            <TextBlock Text="注视5米外绿植" FontSize="10.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#18231C" CornerRadius="10" Padding="10,12">
                        <StackPanel>
                            <TextBlock Text="🤲" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="3. 双手温敷" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                            <TextBlock Text="搓热掌心轻捂眼" FontSize="10.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="#18231C" CornerRadius="10" Padding="10,12">
                        <StackPanel>
                            <TextBlock Text="🧘" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="4. 深呼吸" FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" HorizontalAlignment="Center"/>
                            <TextBlock Text="活动颈椎双肩" FontSize="10.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 操作按钮区 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="✓ 我已充分休息，返回桌面" Appearance="Primary" Height="40" Padding="24,0" Margin="0,0,14,0" Click="BtnComplete_Click"/>
                    <ui:Button Content="稍后 5 分钟提醒" Appearance="Secondary" Height="40" Padding="16,0" Click="BtnSnooze_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
