<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 应用基础信息 -->
    <system:String x:Key="App.Title">海豆·童伴守护 (Haidou ChildGuard) - 纯本地数字健康护航</system:String>
    <system:String x:Key="App.Name">海豆·童伴守护</system:String>
    <system:String x:Key="App.Subtitle">青少年健康用机护航系统</system:String>
    <system:String x:Key="App.VersionPrefix">版本</system:String>
    <system:String x:Key="App.LocalEngineReady">离线引擎运转正常</system:String>
    <system:String x:Key="App.LocalFirstBadge">🛡️ 100% 纯本地离线计算</system:String>

    <!-- 侧边导航栏 -->
    <system:String x:Key="Nav.Overview">今日态势</system:String>
    <system:String x:Key="Nav.Apps">应用使用审计</system:String>
    <system:String x:Key="Nav.Policy">守护策略设定</system:String>
    <system:String x:Key="Nav.Totp">家长绑定与口令</system:String>
    <system:String x:Key="Nav.ScreenAudit">屏幕健康审计</system:String>
    <system:String x:Key="Nav.About">关于与系统设置</system:String>
    <system:String x:Key="Nav.Exit">退出守护星</system:String>

    <!-- 态势面板 (Overview) -->
    <system:String x:Key="Overview.Title">今日健康用机态势</system:String>
    <system:String x:Key="Overview.Subtitle">全方位时间统计、防沉迷规则裁决与护眼守护引擎</system:String>
    <system:String x:Key="Overview.Kpi.ScreenTime">今日累计用屏时长</system:String>
    <system:String x:Key="Overview.Kpi.RemainingTime">今日防沉迷剩余额度</system:String>
    <system:String x:Key="Overview.Kpi.EyeCare">护眼模式</system:String>
    <system:String x:Key="Overview.Kpi.ActiveApp">当前活动前台应用</system:String>
    <system:String x:Key="Overview.Kpi.Running">运行中</system:String>
    <system:String x:Key="Overview.Kpi.Idle">待机中</system:String>
    <system:String x:Key="Overview.Ranking.Title">今日应用时长排行 (Top 5)</system:String>
    <system:String x:Key="Overview.EyeCareCard.Title">视力守护与智能暖光调节</system:String>
    <system:String x:Key="Overview.EyeCareCard.Warmth">蓝光过滤暖度</system:String>
    <system:String x:Key="Overview.EyeCareCard.Countdown">下次视力放松倒计时</system:String>
    <system:String x:Key="Overview.EyeCareCard.Rule202020">遵循 20-20-20 国际视力保护法则：每用屏 20 分钟，眺望 20 英尺外 20 秒</system:String>

    <!-- 应用使用审计面板 (Apps) -->
    <system:String x:Key="Apps.Title">应用使用与会话明细</system:String>
    <system:String x:Key="Apps.Subtitle">本地时间线引擎完整记录各软件启动与活动心跳，断网完整存留</system:String>
    <system:String x:Key="Apps.Col.Process">进程名称</system:String>
    <system:String x:Key="Apps.Col.Title">窗口标题</system:String>
    <system:String x:Key="Apps.Col.Duration">使用时长</system:String>
    <system:String x:Key="Apps.Col.Category">分类属性</system:String>
    <system:String x:Key="Apps.Col.LastActive">最近活跃时间</system:String>
    <system:String x:Key="Apps.Btn.Refresh">🔄 刷新列表</system:String>
    <system:String x:Key="Apps.Btn.Export">📥 导出明细</system:String>

    <!-- 守护策略设定面板 (Policy) -->
    <system:String x:Key="Policy.Title">健康作息与守护策略</system:String>
    <system:String x:Key="Policy.Subtitle">配置青少年每日最大可用额度、连续游戏限制、宵禁时间及网址黑白名单</system:String>
    <system:String x:Key="Policy.DailyLimit">每日累计最大用机时长</system:String>
    <system:String x:Key="Policy.SingleGameLimit">单次连续游戏时长限制</system:String>
    <system:String x:Key="Policy.CurfewTime">夜间宵禁时段 (禁止用机)</system:String>
    <system:String x:Key="Policy.CurfewStart">开始时间</system:String>
    <system:String x:Key="Policy.CurfewEnd">结束时间</system:String>
    <system:String x:Key="Policy.Minutes">分钟</system:String>
    <system:String x:Key="Policy.Btn.Save">💾 保存策略生效</system:String>
    <system:String x:Key="Policy.WebFilter.Title">网络防护与不良站点拦截 (Hosts 离线重定向)</system:String>
    <system:String x:Key="Policy.WebFilter.Placeholder">输入需拦截的域名 (例如: example.com)</system:String>
    <system:String x:Key="Policy.WebFilter.BtnAdd">➕ 添加拦截域名</system:String>

    <!-- 家长口令与 TOTP 认证面板 (Totp) -->
    <system:String x:Key="Totp.Title">家长管理权限与双因子口令 (TOTP)</system:String>
    <system:String x:Key="Totp.Subtitle">基于通用 TOTP 标准算法，支持使用微信小程序、微软 Authenticator 或 Google 验证器扫码绑定</system:String>
    <system:String x:Key="Totp.Card.Bind">📱 动态安全令牌绑定</system:String>
    <system:String x:Key="Totp.ScanTip">使用手机身份验证器扫描下方二维码绑定：</system:String>
    <system:String x:Key="Totp.SecretKey">密钥明文</system:String>
    <system:String x:Key="Totp.VerifyCode">6位动态验证码</system:String>
    <system:String x:Key="Totp.BtnVerify">✅ 验证绑定</system:String>
    <system:String x:Key="Totp.Card.Password">🔑 应急独立管理密码</system:String>
    <system:String x:Key="Totp.NewPassword">新家长密码</system:String>
    <system:String x:Key="Totp.ConfirmPassword">确认新密码</system:String>
    <system:String x:Key="Totp.BtnSavePassword">💾 更新家长密码</system:String>

    <!-- 屏幕健康审计面板 (ScreenAudit) -->
    <system:String x:Key="Audit.Title">屏幕内容健康审计 · 离线智能守护</system:String>
    <system:String x:Key="Audit.Subtitle">Windows 原生离线 OCR + 敏感词字典树 · 100% 本地运算 · 未检出不良信息时 0 文本留存</system:String>
    <system:String x:Key="Audit.BadgeReady">本地 OCR 引擎就绪</system:String>
    <system:String x:Key="Audit.BtnTrigger">⚡ 立即抓样检测</system:String>
    <system:String x:Key="Audit.LockTip">🔒 家长保护已开启：查看屏幕审计违规抓样需要先进行家长身份验证</system:String>
    <system:String x:Key="Audit.BtnUnlock">🔑 家长解锁查看</system:String>
    <system:String x:Key="Audit.Col.Time">抓检时间</system:String>
    <system:String x:Key="Audit.Col.Process">来源进程</system:String>
    <system:String x:Key="Audit.Col.Window">窗口标题</system:String>
    <system:String x:Key="Audit.Col.Category">风险类别</system:String>
    <system:String x:Key="Audit.Col.Status">处置状态</system:String>
    <system:String x:Key="Audit.Col.Action">操作</system:String>
    <system:String x:Key="Audit.BtnAck">确认已知悉</system:String>

    <!-- 关于与系统设置面板 (About & Settings) -->
    <system:String x:Key="About.Title">关于 海豆·童伴守护 (Haidou ChildGuard)</system:String>
    <system:String x:Key="About.Subtitle">项目定位：100% 纯本地、无商业广告、零隐私上云的开源公益级青少年数码健康护航系统。</system:String>
    <system:String x:Key="About.Settings.Title">🌐 语言与国际化设置 (Language Settings)</system:String>
    <system:String x:Key="About.Settings.LangTip">可自动根据国家位置/网络 IP 匹配语言，亦可手动指定：</system:String>
    <system:String x:Key="About.Settings.LangAuto">🌐 自动识别 (根据位置 / IP 智能判断)</system:String>
    <system:String x:Key="About.Settings.LangZh">🇨🇳 简体中文 (Simplified Chinese)</system:String>
    <system:String x:Key="About.Settings.LangEn">🇺🇸 English (US)</system:String>
    <system:String x:Key="About.Settings.DetectedCountry">当前检测国家/地区</system:String>
    <system:String x:Key="About.LocalFirst.Title">🛡️ 绝对数据本地化承诺 (Local-First)</system:String>
    <system:String x:Key="About.LocalFirst.Content">• 绝不上传任何屏幕截图、窗口日志、按键信息至任何云端服务器；&#x0a;• 采用 SQLite 本地闭环存储，密钥受 Windows DPAPI 硬件保护，断网完全正常运行；&#x0a;• 7 天滚动自动覆盖清理，决不无故挤占家庭电脑硬盘空间。</system:String>
    <system:String x:Key="About.Stalkerware.Title">🤝 反跟踪软件联盟 (Coalition Against Stalkerware) 合规宣言</system:String>
    <system:String x:Key="About.Stalkerware.Content">• 我们构建工具是为了引导和保护未成年人的身心视力健康，而非搞隐匿偷窥；&#x0a;• 桌面托盘保持常驻清晰状态，任何屏幕守护动作均有可见透明标识。</system:String>

    <!-- 锁屏与弹窗提示 (Curfew & Breaks) -->
    <system:String x:Key="Curfew.Title">🌙 夜间休眠时间已到</system:String>
    <system:String x:Key="Curfew.Subtitle">现在是宵禁休息时段，保护睡眠健康，明天见！</system:String>
    <system:String x:Key="Curfew.ParentUnlock">🔑 家长临时解锁</system:String>
    <system:String x:Key="EyeCare.Title">👀 视力放松休息提醒</system:String>
    <system:String x:Key="EyeCare.Subtitle">您已经连续用眼一段时间，请将视线离开屏幕，远眺绿色植物或窗外。</system:String>
    <system:String x:Key="EyeCare.RemainingSeconds">剩余休息时间</system:String>
    <system:String x:Key="EyeCare.Seconds">秒</system:String>

    <!-- 托盘与系统对话框 -->
    <system:String x:Key="Tray.Tooltip">海豆·童伴守护 (运行中)</system:String>
    <system:String x:Key="Tray.ShowMain">🖥️ 显示主界面</system:String>
    <system:String x:Key="Tray.ToggleEyeCare">🌿 开启/关闭护眼滤镜</system:String>
    <system:String x:Key="Tray.Exit">❌ 安全退出系统</system:String>
    <system:String x:Key="Dialog.ParentAuthRequired">家长身份验证</system:String>
    <system:String x:Key="Dialog.InputPassword">请输入家长独立管理密码或 6 位 TOTP 动态安全码：</system:String>
    <system:String x:Key="Dialog.PasswordWrong">验证失败：密码错误或动态口令失效，请重试！</system:String>
    <system:String x:Key="Dialog.PolicySavedSuccess">策略设置保存成功，已即刻生效！</system:String>
    <system:String x:Key="Dialog.ExitConfirmTitle">退出守护星确认</system:String>
    <system:String x:Key="Dialog.ExitConfirmMessage">您确定要退出童伴守护吗？退出后时间监控与屏幕守护功能将暂停运行。</system:String>

    <!-- 通用按钮 -->
    <system:String x:Key="Common.Confirm">确定</system:String>
    <system:String x:Key="Common.Cancel">取消</system:String>
    <system:String x:Key="Common.Save">保存</system:String>
    <system:String x:Key="Common.Close">关闭</system:String>
</ResourceDictionary>