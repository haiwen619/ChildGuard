                                            <StackPanel>
                                                <TextBlock Text="➕ 添加要拦截的网站域名 (需家长安全核验)" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="InputNewBlockedDomain" Grid.Column="0" Height="36"
                                                             Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"
                                                             VerticalContentAlignment="Center" Padding="10,0"
                                                             KeyDown="InputNewBlockedDomain_KeyDown"
                                                             ToolTip="输入网址域名，例如: bilibili.com 或 douyin.com 或 tieba.baidu.com"/>
                                                    <ui:Button Grid.Column="2" Content="+ 授权添加屏蔽" Appearance="Primary" Height="36" Padding="18,0"
                                                               Click="BtnAddBlockedDomain_Click"/>
                                                </Grid>
                                                <TextBlock Text="💡 提示：输入网址域名（如 bilibili.com），系统将自动将其及二级域名加入全系统底层 Hosts 阻断列表。"
                                                           FontSize="11" Foreground="#6E7681" Margin="2,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 当前屏蔽清单与分类统计 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📋 拦截规则管理清单" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtRuleCountStats" Text="(加载中...)" FontSize="11.5" Foreground="#7D8590" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnFilterCustom" Content="👤 家长自定义" FontSize="11" Height="26" Padding="8,0" Background="#21262D" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,4,0" Click="BtnFilterCategory_Click" Tag="Custom"/>
                                                <Button x:Name="BtnFilterAdult" Content="🔞 成人低俗" FontSize="11" Height="26" Padding="8,0" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="0,0,4,0" Click="BtnFilterCategory_Click" Tag="Adult"/>
                                                <Button x:Name="BtnFilterGambling" Content="🎲 涉赌网彩" FontSize="11" Height="26" Padding="8,0" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="0,0,4,0" Click="BtnFilterCategory_Click" Tag="Gambling"/>
                                                <Button x:Name="BtnFilterGameGray" Content="🎮 租号外挂" FontSize="11" Height="26" Padding="8,0" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="0,0,4,0" Click="BtnFilterCategory_Click" Tag="GameGray"/>
                                                <Button x:Name="BtnFilterPhishing" Content="🎣 钓鱼欺诈" FontSize="11" Height="26" Padding="8,0" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Margin="0,0,4,0" Click="BtnFilterCategory_Click" Tag="Phishing"/>
                                                <Button x:Name="BtnFilterAll" Content="全部" FontSize="11" Height="26" Padding="8,0" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Click="BtnFilterCategory_Click" Tag="All"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 内置不良网址库：默认安全封存盾牌卡片 (防不良诱导与广告效应) -->
                                        <Border x:Name="CardBuiltinShieldLocked" Background="#141923" BorderBrush="#263040" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#1B2536" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="通用不良与涉赌网址核心防护库 (StevenBlack 规则)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                        <Border Background="#1C3827" CornerRadius="4" Padding="6,1,6,2">
                                                            <TextBlock Text="🔒 深度脱敏封存 · 零反向诱导" FontSize="10.5" Foreground="#3FB950" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="根据《未成年人网络保护条例》防不良诱导规范，内置涉黄、涉赌等有害域名默认封存并不予明文罗列，避免反向告知未成年人。底层 Hosts 持续生效拦截中。"
                                                               TextWrapping="Wrap" FontSize="11" Foreground="#8B949E" LineHeight="17"/>
                                                    <!-- 四大维度分类防护徽章 -->
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Border Background="#24161C" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock x:Name="TxtCountAdult" Text="🔞 成人低俗防护: 60 核心站" FontSize="10.5" Foreground="#FF7B72"/>
                                                        </Border>
                                                        <Border Background="#242116" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock x:Name="TxtCountGambling" Text="🎲 涉赌网彩防护: 46 核心站" FontSize="10.5" Foreground="#D29922"/>
                                                        </Border>
                                                        <Border Background="#162224" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock x:Name="TxtCountGameGray" Text="🎮 租号外挂黑产: 33 核心站" FontSize="10.5" Foreground="#58A6FF"/>
                                                        </Border>
                                                        <Border Background="#1E1928" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                            <TextBlock x:Name="TxtCountPhishing" Text="🎣 钓鱼欺诈陷阱: 19 核心站" FontSize="10.5" Foreground="#BC8CFF"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <ui:Button x:Name="BtnUnlockBuiltinRules" Grid.Column="2" Content="🔓 家长授权查阅" Appearance="Secondary" Height="34" Padding="14,0"
                                                           VerticalAlignment="Center" Click="BtnUnlockBuiltinRules_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 内置不良网址库：临时解锁展示警示状态栏 -->
                                        <Border x:Name="BarBuiltinShieldUnlocked" Visibility="Collapsed" Background="#261E14" BorderBrush="#593D1D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="⚠️ 警示：内置不良域名库已临时安全解锁展示！" FontSize="12" FontWeight="Bold" Foreground="#F0883E"/>
                                                    <TextBlock Text="请严格确保周围无未成年人窥见。查阅完成后请立即点击右侧锁闭。" FontSize="10.5" Foreground="#C9D1D9" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" x:Name="BtnToggleMask" Content="👁️ 切换脱敏/明文" Appearance="Secondary" Height="28" Padding="10,0" Click="BtnToggleMask_Click"/>
                                                <ui:Button Grid.Column="3" Content="🔒 立即锁闭隐藏" Appearance="Danger" Height="28" Padding="12,0" Click="BtnLockBuiltinRules_Click"/>
                                            </Grid>
                                        </Border>

                                        <!-- 空自定义规则提示 -->
                                        <Border x:Name="CardNoCustomRules" Visibility="Collapsed" Background="#12151B" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="💡 目前暂无家长自定义拦截网址" FontSize="12.5" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="您可以使用上方输入框，添加需要限制孩子访问的特定游戏或社交网站（如 bilibili.com）" FontSize="11" Foreground="#484F58" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 规则卡片滚动列表 (默认仅展示家长自定义) -->
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                                            <ItemsControl x:Name="ListBlockedRules">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#12161E" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="🌐" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                        <TextBlock Text="{Binding DisplayDomain}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                                        <Border Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,1,6,2">
                                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="{Binding BadgeColor}" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#7D8590" Margin="0,0,12,0"/>
                                                                        <TextBlock Text="🟢 底层阻断生效中" FontSize="11" Foreground="#3FB950"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <ui:Button Grid.Column="2" Content="🗑️ 移除" Appearance="Danger" Height="28" Padding="12,0" FontSize="11.5"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding DeleteButtonVisibility}"
                                                                           Tag="{Binding Domain}"
                                                                           Click="BtnDeleteRule_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 面板 3: TOTP 离线绑定与密码管理 -->
                        <ScrollViewer x:Name="PanelTotp" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="家长离线双重身份验证 (2FA) 与主密码" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="100% 纯本地运作，0 网络请求。密码与密钥均经 Windows DPAPI 加密固化保护。"
                                           FontSize="12" Foreground="#8B949E" Margin="0,0,0,20"/>

                                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🔑 家长安全主密码管理" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <TextBlock Text="此密码用于阻止非授权退出软件与保护限额策略，支持随时修改更新。" FontSize="12" Foreground="#7D8590" Margin="0,0,0,14"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="原主密码:" VerticalAlignment="Center" Foreground="#C9D1D9" Margin="0,0,8,0"/>
                                            <PasswordBox x:Name="InputOldPwd" Width="130" Height="34" Margin="0,0,14,0" Background="#16181D" Foreground="#FFFFFF" BorderBrush="#30363D"/>
                                            <TextBlock Text="新主密码:" VerticalAlignment="Center" Foreground="#C9D1D9" Margin="0,0,8,0"/>
                                            <PasswordBox x:Name="InputNewPwdChange" Width="130" Height="34" Margin="0,0,14,0" Background="#16181D" Foreground="#FFFFFF" BorderBrush="#30363D"/>
                                            <ui:Button Content="修改主密码" Appearance="Primary" Click="BtnChangePassword_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtChangePwdResult" Text="" FontSize="12" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 二维码显示卡片 -->
                                    <Border Grid.Column="0" Background="#16181D" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border CornerRadius="8" Background="#FFFFFF" Padding="6" Margin="0,0,0,10">
                                                <Image x:Name="ImgTotpQr" Width="190" Height="190"/>
                                            </Border>
                                            <TextBlock Text="使用手机身份验证器扫码" HorizontalAlignment="Center" FontSize="11.5" Foreground="#7D8590"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 绑定操作 -->
                                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                        <TextBlock Text="密钥 (Base32 编码，已通过 Windows DPAPI 本地固化保护):" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="TxtTotpSecret" IsReadOnly="True" Width="400" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                        <TextBlock Text="扫码完成后，请输入手机上生成的 6 位动态验证码进行验证测试:" FontSize="12.5" Foreground="#C9D1D9" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:TextBox x:Name="InputTotpCode" PlaceholderText="输入 6 位数字" Width="140" MaxLength="6" Margin="0,0,12,0"/>
                                            <ui:Button Content="离线验证" Appearance="Primary" Click="BtnVerifyTotp_Click" Margin="0,0,12,0"/>
                                            <ui:Button Content="重置生成新密钥" Appearance="Secondary" Click="BtnResetTotp_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtTotpResult" Text="" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 面板 4: 关于与公益声明 -->
                        <ScrollViewer x:Name="PanelAbout" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="关于 海豆·童伴守护 (Haidou ChildGuard)" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="项目定位：100% 纯本地、无商业广告、零隐私上云的开源公益级青少年数码健康护航系统。"
                                           FontSize="12" Foreground="#8B949E" Margin="0,0,0,20"/>

                                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ 绝对数据本地化承诺 (Local-First)" FontSize="14.5" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,6"/>
                                        <TextBlock Text="• 绝不上传任何屏幕截图、窗口日志、按键信息至任何云端服务器；&#x0a;• 采用 SQLite 本地闭环存储，密钥受 Windows DPAPI 硬件保护，断网完全正常运行；&#x0a;• 7 天滚动自动覆盖清理，决不无故挤占家庭电脑硬盘空间。"
                                                   TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="20"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KpiCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🤝 反跟踪软件联盟 (Coalition Against Stalkerware) 合规宣言" FontSize="14.5" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,6"/>
                                        <TextBlock Text="• 我们构建工具是为了引导和保护未成年人的身心视力健康，而非搞隐匿偷窥；&#x0a;• 桌面托盘保持常驻清晰状态，任何屏幕守护动作均有可见透明标识。"
                                                   TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 全屏模态弹窗遮罩 (用于首次设置家长密码与退出核销) -->
        <Grid x:Name="ModalHost" Visibility="Collapsed" Panel.ZIndex="9999" Background="#D9080A0E">
            <!-- 模态框 1: 首次启动设定家长密码 -->
            <Border x:Name="ModalSetupPassword" Visibility="Collapsed"
                    Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#2D333B" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#1C3827" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🔐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="首次使用 · 请设置家长主密码" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="防止未成年人在任务管理器中轻易退出" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="为保证守护系统在本地有效运转，您需要设置一个专属管理密码。日常退出守护软件、修改屏幕时长策略时均需输入此密码核验。"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="19" Margin="0,0,0,18"/>

                    <TextBlock Text="请设置主密码 (支持字母或数字，至少 4 位):" FontSize="12.5" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputNewPassword" Height="36" Margin="0,0,0,14" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>

                    <TextBlock Text="请再次确认主密码:" FontSize="12.5" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputConfirmPassword" Height="36" Margin="0,0,0,10" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>

                    <TextBlock x:Name="TxtSetupError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <ui:Button Content="完成设置并激活系统保护" Appearance="Primary" Height="38" HorizontalAlignment="Stretch" Click="BtnConfirmSetupPassword_Click"/>
                </StackPanel>
            </Border>

            <!-- 模态框 2: 家长身份核销 · 退出童伴守护 -->
            <Border x:Name="ModalExitAuth" Visibility="Collapsed"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#3D2929" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#3D1D1D" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="家长身份核销 · 退出童伴守护" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="系统处于持续健康护航中" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="若要完全关闭退出童伴守护，请输入您设置的家长密码（或使用手机身份验证器上绑定的 6 位动态验证码）："
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="19" Margin="0,0,0,18"/>

                    <PasswordBox x:Name="InputExitPassword" Height="36" Margin="0,0,0,10" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>
                    <TextBlock x:Name="TxtExitError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="取消" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="BtnCancelExit_Click"/>
                        <ui:Button Grid.Column="2" Content="验证并退出" Appearance="Danger" Height="36" HorizontalAlignment="Stretch" Click="BtnConfirmExit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 模态框 3: 家长敏感操作安全核验 (修改网站屏蔽/黑名单/策略) -->
            <Border x:Name="ModalParentActionAuth" Visibility="Collapsed"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#2D3B31" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#1C3827" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🔐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="家长身份安全核验" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="防止未成年人擅自篡改或停用保护策略" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#12151B" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtParentActionPrompt" Text="正在执行敏感策略修改..."
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#58A6FF" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="请输入家长管理密码 (或输入手机验证器 6 位动态验证码):"
                               FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputParentActionPassword" Height="36" Margin="0,0,0,10"
                                 Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"
                                 KeyDown="InputParentActionPassword_KeyDown"/>
                    <TextBlock x:Name="TxtParentActionError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="取消操作" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="BtnCancelParentAction_Click"/>
                        <ui:Button Grid.Column="2" Content="确认授权并执行" Appearance="Primary" Height="36" HorizontalAlignment="Stretch" Click="BtnConfirmParentAction_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 模态框 4: 家长知情同意与查阅证书确认 (查看内置不良库) -->
            <Border x:Name="ModalSensitiveUnlockCert" Visibility="Collapsed"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#593D1D" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#3D291D" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="📜" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="家长知情同意与敏感内容查阅承诺书" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="未成年人防诱导与保护安全证书" FontSize="11" Foreground="#F0883E"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 协议承诺证书卡片 -->
                    <Border Background="#101319" BorderBrush="#2D333B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🛡️ 监护人安全知情与防诱导保密承诺：" FontSize="12" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,6"/>
                            <TextBlock Text="1. [防反向诱导] 本内置库包含涉黄、涉赌等违法不良域名样本，明文展示可能对未成年人造成负面诱导；&#x0a;2. [环境确认] 本人作为法定监护人，确认当前物理屏幕环境安全，周围绝对无未成年人在场；&#x0a;3. [严禁转述] 查阅明细仅供核验底层防护有效性，本人承诺绝不向未成年人转述或展示具体域名；&#x0a;4. [临时授权] 本次授权仅在当前前台会话临时有效，最小化或离开即刻自动失效并锁闭。"
                                       TextWrapping="Wrap" FontSize="11" Foreground="#8B949E" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- 勾选确认再确认 -->
                    <CheckBox x:Name="ChkAgreeSensitiveCert" Margin="0,0,0,14" Click="ChkAgreeSensitiveCert_Click">
                        <TextBlock Text="我已充分阅读并签署上述承诺，确认当前环境安全，申请临时查阅" FontSize="11.5" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                    </CheckBox>

                    <TextBlock Text="请输入家长主管理密码 (或输入手机验证器 6 位动态验证码):"
                               FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputSensitiveCertPassword" Height="36" Margin="0,0,0,8"
                                 Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"
                                 KeyDown="InputSensitiveCertPassword_KeyDown"/>
                    <TextBlock x:Name="TxtSensitiveCertError" Text="" FontSize="11.5" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="取消放弃" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="BtnCancelSensitiveCert_Click"/>
                        <ui:Button Grid.Column="2" x:Name="BtnConfirmSensitiveCert" Content="签署承诺并验证解锁" Appearance="Danger" Height="36" HorizontalAlignment="Stretch" IsEnabled="False" Click="BtnConfirmSensitiveCert_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>