                                        </Border>
                                        <TextBlock Text="未成年人隐私保护屏障已生效" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="本系统坚持《反跟踪软件联盟》隐私合规原则。为防止日常正常浏览被无端窥探，所有屏幕内容审计记录均受强安全隔离。只有输入家长管理密码后方可审阅检测日志。"
                                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="#8B949E" LineHeight="19" Margin="0,0,0,20"/>
                                        <ui:Button Content="🔐 输入家长管理密码解锁审阅" Appearance="Primary" Height="38" Padding="24,0" HorizontalAlignment="Center" Click="BtnUnlockAuditRecords_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 解锁状态视图 -->
                                <StackPanel x:Name="AuditUnlockedContainer" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="历史违规告警" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="TxtAuditTotalCount" Text="0 次" FontSize="22" FontWeight="Bold" Foreground="#FF7B72"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="待确认处置" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="TxtAuditPendingCount" Text="0 条" FontSize="22" FontWeight="Bold" Foreground="#F0883E"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="离线巡检频率" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6"/>
                                                <TextBlock Text="每 25 秒自动巡检" FontSize="18" FontWeight="Bold" Foreground="#3FB950"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="敏感与违规事件明细" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Content="🔄 刷新列表" Appearance="Secondary" Height="28" Padding="12,0" Margin="0,0,8,0" Click="BtnRefreshAuditList_Click"/>
                                            <ui:Button Content="🔒 重新锁定隐私" Appearance="Secondary" Height="28" Padding="12,0" Click="BtnRelockAuditRecords_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <ListView x:Name="ListScreenAudits" Background="Transparent" BorderThickness="0"
                                              ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                                              MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{Binding RiskBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding RiskLevelName}" FontSize="11" FontWeight="Bold" Foreground="{Binding RiskBadgeForeground}"/>
                                                            </Border>
                                                            <Border Background="#1C2838" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#58A6FF"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                                            <TextBlock Text="-" FontSize="12" Foreground="#6E7681" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding WindowTitle}" FontSize="11.5" Foreground="#8B949E" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeFormatted}" FontSize="11" Foreground="#7D8590" Margin="0,0,12,0"/>
                                                            <ui:Button Content="{Binding StatusText}" Appearance="Secondary" Height="24" Padding="8,0"
                                                                       Foreground="{Binding StatusForeground}"
                                                                       Click="BtnAcknowledgeAudit_Click" Tag="{Binding Id}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Border Background="#101216" CornerRadius="6" Padding="10,6">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <TextBlock Text="命中词汇: " FontSize="11.5" Foreground="#7D8590"/>
                                                                    <TextBlock Text="{Binding MatchedKeywords}" FontSize="11.5" FontWeight="Bold" Foreground="#FF7B72"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="上下文片段: " FontSize="11" Foreground="#7D8590"/>
                                                                    <TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="#C9D1D9" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock x:Name="TxtEmptyAuditNotice" Text="暂未检测到任何敏感或不良屏幕内容，孩子正在健康合规使用电脑。"
                                               FontSize="13" Foreground="#7D8590" HorizontalAlignment="Center" Margin="0,40,0,40" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 全屏模态弹窗遮罩 (用于首次设置家长密码与退出核销) -->
        <Grid x:Name="ModalHost" Visibility="Collapsed" Panel.ZIndex="9999" Background="#D9080A0E">
            <!-- 模态框 1: 首次启动设定家长密码 -->
            <Border x:Name="ModalSetupPassword" Visibility="Collapsed"
                    Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#2D333B" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#1C3827" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🔐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="首次使用 · 请设置家长主密码" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="防止未成年人在任务管理器中轻易退出" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="为保证守护系统在本地有效运转，您需要设置一个专属管理密码。日常退出守护软件、修改屏幕时长策略时均需输入此密码核验。"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="19" Margin="0,0,0,18"/>

                    <TextBlock Text="请设置主密码 (支持字母或数字，至少 4 位):" FontSize="12.5" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputNewPassword" Height="36" Margin="0,0,0,14" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>

                    <TextBlock Text="请再次确认主密码:" FontSize="12.5" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputConfirmPassword" Height="36" Margin="0,0,0,10" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>

                    <TextBlock x:Name="TxtSetupError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <ui:Button Content="完成设置并激活系统保护" Appearance="Primary" Height="38" HorizontalAlignment="Stretch" Click="BtnConfirmSetupPassword_Click"/>
                </StackPanel>
            </Border>

            <!-- 模态框 2: 家长身份核销 · 退出童伴守护 -->
            <Border x:Name="ModalExitAuth" Visibility="Collapsed"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#3D2929" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#3D1D1D" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="家长身份核销 · 退出童伴守护" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="系统处于持续健康护航中" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="若要完全关闭退出童伴守护，请输入您设置的家长密码（或使用手机身份验证器上绑定的 6 位动态验证码）："
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#8B949E" LineHeight="19" Margin="0,0,0,18"/>

                    <PasswordBox x:Name="InputExitPassword" Height="36" Margin="0,0,0,10" Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"/>
                    <TextBlock x:Name="TxtExitError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="取消" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="BtnCancelExit_Click"/>
                        <ui:Button Grid.Column="2" Content="验证并退出" Appearance="Danger" Height="36" HorizontalAlignment="Stretch" Click="BtnConfirmExit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- 模态框 3: 家长敏感操作安全核验 (修改网站屏蔽/黑名单/策略) -->
            <Border x:Name="ModalParentActionAuth" Visibility="Collapsed"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#16191F" BorderBrush="#2D3B31" BorderThickness="1"
                    CornerRadius="14" Padding="28,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.85" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#1C3827" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                            <TextBlock Text="🔐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="家长身份安全核验" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="防止未成年人擅自篡改或停用保护策略" FontSize="11.5" Foreground="#7D8590"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#12151B" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtParentActionPrompt" Text="正在执行敏感策略修改..."
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#58A6FF" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="请输入家长管理密码 (或输入手机验证器 6 位动态验证码):"
                               FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="InputParentActionPassword" Height="36" Margin="0,0,0,10"
                                 Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#30363D"
                                 KeyDown="InputParentActionPassword_KeyDown"/>
                    <TextBlock x:Name="TxtParentActionError" Text="" FontSize="12" Foreground="#FF7B72" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="取消操作" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="BtnCancelParentAction_Click"/>
                        <ui:Button Grid.Column="2" Content="确认授权并执行" Appearance="Primary" Height="36" HorizontalAlignment="Stretch" Click="BtnConfirmParentAction_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
                    </Grid>
    </Grid>
</ui:FluentWindow>

